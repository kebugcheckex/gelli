<resources>

    <style name="Theme.Phonograph" parent="Theme.Phonograph.Base">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Phonograph.Light" parent="Theme.Phonograph.Base.Light">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Phonograph.Notification" parent="@android:style/TextAppearance.Material.Notification" />

    <style name="Theme.Phonograph.Notification.Title" parent="@android:style/TextAppearance.Material.Notification.Title" />

    <style name="OverFlowButton">
        <item name="srcCompat">@drawable/ic_more_vert_white_24dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:focusable">false</item>
    </style>

    <!-- for a toolbar on an album colour, with white icons and title whatever the theme -->
    <style name="Toolbar.OnColor" parent="Widget.AppCompat.Toolbar">
        <item name="titleMarginStart">16dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:minHeight">@dimen/toolbar_height</item>
        <item name="android:theme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="popupTheme">?toolbarPopupTheme</item>
        <item name="android:elevation">@dimen/toolbar_elevation</item>
        <item name="android:transitionName">toolbar</item>
    </style>

    <style name="LoginScreen" parent="Theme.Phonograph">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- an icon button of any size: the layout sets the size, and the icon stays centered -->
    <style name="Widget.Gelli.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Gelli.IconButton.Filled">
        <item name="backgroundTint">@color/m3_filled_icon_button_container_color_selector</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Button.IconButton.Filled</item>
    </style>

    <!-- the framework track is translucent on its own, which would wash out these colors -->
    <style name="Widget.Gelli.SeekBar" parent="android:Widget.Material.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_track</item>
        <item name="android:progressTint">?attr/colorPrimary</item>
        <item name="android:progressBackgroundTint">?attr/colorSurfaceContainerHighest</item>
        <item name="android:thumbTint">?attr/colorPrimary</item>
    </style>

    <!-- on an album color, where colorPrimary could be hard to see -->
    <style name="Widget.Gelli.SeekBar.OnColor">
        <item name="android:progressTint">@android:color/white</item>
        <item name="android:progressBackgroundTint">#40FFFFFF</item>
        <item name="android:thumbTint">@android:color/white</item>
    </style>

    <!-- the library has no Material 3 theme, so its rows are replaced with our own layouts -->
    <style name="ThemeOverlay.Gelli.Preference" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/Preference.Gelli</item>
        <item name="dialogPreferenceStyle">@style/Preference.Gelli.Dialog</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.Gelli.Switch</item>
        <item name="seekBarPreferenceStyle">@style/Preference.Gelli.SeekBar</item>
    </style>

    <style name="Preference.Gelli" parent="Preference.Material">
        <item name="android:layout">@layout/preference_row</item>
    </style>

    <style name="Preference.Gelli.Dialog" parent="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/preference_row</item>
    </style>

    <style name="Preference.Gelli.Switch" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/preference_row</item>
        <item name="android:widgetLayout">@layout/preference_widget_material_switch</item>
    </style>

    <style name="Preference.Gelli.SeekBar" parent="Preference.SeekBarPreference.Material">
        <item name="android:layout">@layout/preference_row_seekbar</item>
    </style>

    <!-- rounded covers on the grid tiles and the now playing pane -->
    <style name="ShapeAppearance.Gelli.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- the landscape player always sits on a dark palette gradient, whatever the app theme -->
    <style name="ThemeOverlay.Gelli.LandscapePlayer" parent="">
        <item name="isLightTheme">false</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:textColorTertiary">@color/text_secondary_dark</item>
        <item name="dividerColor">#1AFFFFFF</item>
        <item name="colorOnSurface">@android:color/white</item>
        <item name="colorOnSurfaceVariant">#B3FFFFFF</item>
        <item name="colorOutlineVariant">#40FFFFFF</item>
        <item name="colorControlNormal">#B3FFFFFF</item>
        <item name="colorControlHighlight">#33FFFFFF</item>
    </style>

    <!-- the Up next and Details switch in the landscape player -->
    <style name="Widget.Gelli.LandscapePlayer.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/landscape_player_segment_text</item>
        <item name="backgroundTint">@color/landscape_player_segment_background</item>
        <item name="strokeColor">#40FFFFFF</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:minWidth">120dp</item>
    </style>

    <!-- use with MaterialToolbar, which is what tints the navigation icon -->
    <style name="Toolbar.Surface" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="titleMarginStart">16dp</item>
    </style>

</resources>
