<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:colorBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <dev.kebugcheck.gelli.views.IconImageView
        android:id="@+id/drag_view"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/reorder_address"
        android:scaleType="center"
        app:srcCompat="@drawable/ic_drag_vertical_white_24dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="?textAppearanceBodyLarge"
            tools:text="http://192.168.1.10:8096" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="?textAppearanceBodyMedium"
            android:textColor="?android:textColorSecondary"
            tools:text="Reachable · in use" />

    </LinearLayout>

    <dev.kebugcheck.gelli.views.IconImageView
        android:id="@+id/delete"
        style="@style/OverFlowButton"
        android:contentDescription="@string/remove_address"
        app:srcCompat="@drawable/ic_delete_white_24dp" />

</LinearLayout>
