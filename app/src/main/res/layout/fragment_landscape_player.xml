<?xml version="1.0" encoding="utf-8"?>
<!--
the full-window player in any window wider than it is tall: the cover on the left, with the lyrics laid
over it, and on the right the track, the controls and the queue. It is always dark, with a gradient from
the cover palette, and it is inflated with ThemeOverlay.Gelli.LandscapePlayer.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/landscape_player_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/landscape_player_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/landscape_player_close_button"
                style="@style/Widget.Gelli.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/action_close_player"
                app:icon="@drawable/ic_expand_more_white_24dp"
                app:iconSize="28dp" />

            <LinearLayout
                android:id="@+id/landscape_player_source"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="112dp"
                android:layout_marginEnd="64dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/action_go_to_album"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/from_the_album"
                    android:textAppearance="?textAppearanceLabelMedium"
                    android:textColor="?android:textColorSecondary" />

                <TextView
                    android:id="@+id/landscape_player_album"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?textAppearanceTitleSmall"
                    android:textColor="?android:textColorPrimary"
                    tools:text="Tidewater" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/landscape_player_lyrics_button"
                style="@style/Widget.Gelli.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/action_show_lyrics"
                app:icon="@drawable/ic_lyrics_border_white_24dp"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/landscape_player_menu_button"
                style="@style/Widget.Gelli.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/abc_action_menu_overflow_description"
                app:icon="@drawable/ic_more_vert_white_24dp"
                app:iconSize="24dp" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/landscape_player_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/landscape_player_margin"
            android:paddingBottom="@dimen/landscape_player_bottom_padding">

            <!-- the largest square that fits the height and the left 45% -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/landscape_player_cover_card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:cardBackgroundColor="#33000000"
                app:cardCornerRadius="18dp"
                app:cardElevation="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@id/landscape_player_guideline"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <fragment
                    android:id="@+id/player_album_cover_fragment"
                    class="com.dkanada.gramophone.fragments.player.PlayerAlbumCoverFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- the lyrics sit on a translucent scrim, so the cover stays in view behind them -->
                <com.dkanada.gramophone.views.LyricsView
                    android:id="@+id/landscape_player_lyrics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/landscape_player_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.45" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/landscape_player_gap"
                android:clipChildren="false"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/landscape_player_cover_card"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/landscape_player_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:singleLine="true"
                            android:textColor="?android:textColorPrimary"
                            android:textSize="@dimen/landscape_player_title_size"
                            android:textStyle="bold"
                            tools:text="Breakwater" />

                        <TextView
                            android:id="@+id/landscape_player_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textAppearance="?textAppearanceTitleMedium"
                            android:textColor="?android:textColorSecondary"
                            tools:text="June Okafor • Tidewater" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/landscape_player_favorite_button"
                        style="@style/Widget.Gelli.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/action_add_to_favorites"
                        app:icon="@drawable/ic_favorite_border_white_24dp"
                        app:iconSize="28dp" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/landscape_player_progress_slider"
                    style="@style/Widget.Gelli.SeekBar.OnColor"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginStart="-16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="-16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/landscape_player_current_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:textAppearance="?textAppearanceLabelMedium"
                        android:textColor="?android:textColorSecondary"
                        tools:text="2:14" />

                    <TextView
                        android:id="@+id/landscape_player_total_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textAppearance="?textAppearanceLabelMedium"
                        android:textColor="?android:textColorSecondary"
                        tools:text="4:38" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/landscape_player_controls_height"
                    android:gravity="center"
                    android:layoutDirection="ltr"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/landscape_player_shuffle_button"
                        style="@style/Widget.Gelli.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/action_shuffle"
                        app:icon="@drawable/ic_shuffle_white_24dp"
                        app:iconSize="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/landscape_player_prev_button"
                        style="@style/Widget.Gelli.IconButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="16dp"
                        android:contentDescription="@string/action_previous"
                        app:icon="@drawable/ic_skip_previous_white_24dp"
                        app:iconSize="32dp" />

                    <FrameLayout
                        android:layout_width="@dimen/landscape_player_play_size"
                        android:layout_height="@dimen/landscape_player_play_size"
                        android:layout_marginStart="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/landscape_player_play_pause_button"
                            style="@style/Widget.Gelli.IconButton.Filled"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/action_play_pause"
                            app:backgroundTint="@android:color/white"
                            app:iconTint="#FF1A1A1A"
                            app:rippleColor="#33000000"
                            app:iconSize="24dp" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/landscape_player_buffering_indicator"
                            style="@style/Widget.Material3.CircularProgressIndicator.Legacy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorInset="0dp"
                            app:indicatorSize="@dimen/landscape_player_play_size"
                            app:trackThickness="3dp" />

                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/landscape_player_next_button"
                        style="@style/Widget.Gelli.IconButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="16dp"
                        android:contentDescription="@string/action_next"
                        app:icon="@drawable/ic_skip_next_white_24dp"
                        app:iconSize="32dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/landscape_player_repeat_button"
                        style="@style/Widget.Gelli.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="16dp"
                        android:contentDescription="@string/action_repeat"
                        app:icon="@drawable/ic_repeat_white_24dp"
                        app:iconSize="24dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:singleLine="true"
                    android:text="@string/up_next"
                    android:textAppearance="?textAppearanceTitleSmall"
                    android:textColor="?android:textColorSecondary" />

                <!-- a fragment tag has no container for the list to take the dark overlay from -->
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/landscape_player_queue_fragment"
                    android:name="com.dkanada.gramophone.fragments.player.PlayingQueueListFragment"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="-16dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</FrameLayout>
