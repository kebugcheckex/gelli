<?xml version="1.0" encoding="utf-8"?>
<!-- top of the library rail: the drawer with libraries and settings, then shuffle all -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rail_menu"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/action_libraries"
        app:icon="@drawable/ic_menu_white_24dp"
        app:iconTint="?colorOnSurfaceVariant" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/rail_shuffle"
        style="@style/Widget.Material3.FloatingActionButton.Surface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/action_shuffle_all"
        app:elevation="2dp"
        app:srcCompat="@drawable/ic_shuffle_white_24dp" />

</LinearLayout>
