<?xml version="1.0" encoding="utf-8"?>
<!--
the collapsed player at w840dp: the current song on the left, transport and progress in the middle,
and the queue and expand buttons on the right. tapping the bar outside the controls expands the player.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_player_height"
    android:clickable="true"
    android:focusable="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="top"
        android:background="?attr/dividerColor" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/player_bar_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/player_bar_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?textAppearanceTitleSmall"
                    android:textColor="?android:textColorPrimary"
                    tools:text="Song title" />

                <TextView
                    android:id="@+id/player_bar_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?textAppearanceBodyMedium"
                    android:textColor="?android:textColorSecondary"
                    tools:text="Artist • Album" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/player_bar_favorite_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/roundSelector"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/action_add_to_favorites"
                app:srcCompat="@drawable/ic_favorite_border_white_24dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/player_bar_controls_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/player_bar_shuffle_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/roundSelector"
                    android:contentDescription="@string/action_shuffle"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_shuffle_white_24dp" />

                <ImageButton
                    android:id="@+id/player_bar_prev_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="?attr/roundSelector"
                    android:contentDescription="@string/action_previous"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_skip_previous_white_24dp" />

                <ImageButton
                    android:id="@+id/player_bar_play_pause_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/play_pause_filled_background"
                    android:contentDescription="@string/action_play_pause"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic_pause_white_24dp" />

                <ImageButton
                    android:id="@+id/player_bar_next_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/roundSelector"
                    android:contentDescription="@string/action_next"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_skip_next_white_24dp" />

                <ImageButton
                    android:id="@+id/player_bar_repeat_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/roundSelector"
                    android:contentDescription="@string/action_repeat"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_repeat_white_24dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_bar_current_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="40dp"
                    android:singleLine="true"
                    android:textAppearance="?textAppearanceLabelSmall"
                    android:textColor="?android:textColorSecondary"
                    tools:text="2:14" />

                <SeekBar
                    android:id="@+id/player_bar_progress_slider"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/player_bar_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="40dp"
                    android:singleLine="true"
                    android:textAppearance="?textAppearanceLabelSmall"
                    android:textColor="?android:textColorSecondary"
                    tools:text="4:38" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/player_bar_queue_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/roundSelector"
                android:contentDescription="@string/action_toggle_queue"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_queue_music_white_24dp" />

            <ImageButton
                android:id="@+id/player_bar_expand_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/roundSelector"
                android:contentDescription="@string/action_open_player"
                android:padding="13dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_open_in_full_white_24dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
