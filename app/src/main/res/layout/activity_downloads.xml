<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.DownloadsActivity">

    <include layout="@layout/status_bar" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar.Surface" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/loading"
        style="@style/Widget.Material3.LinearProgressIndicator.Legacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:visibility="invisible" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/scope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="@string/downloads_scope"
                android:textAppearance="?textAppearanceBodyMedium" />

            <TextView
                android:id="@+id/no_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/downloads_no_account"
                android:textAppearance="?textAppearanceBodyLarge"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:id="@+id/coverage_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/coverage_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/coverage_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/downloads_checking_local"
                            android:textAppearance="?textAppearanceHeadlineSmall"
                            tools:text="26% available offline" />

                        <TextView
                            android:id="@+id/coverage_count"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:importantForAccessibility="no"
                            android:textAppearance="?textAppearanceBodyLarge"
                            tools:text="1,248 of 4,800 songs" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/coverage_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:importantForAccessibility="no"
                            android:max="10000"
                            android:visibility="gone"
                            app:trackThickness="8dp"
                            tools:progress="2600"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/downloads_includes_saves"
                        android:textAppearance="?textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/library_checked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="?textAppearanceBodySmall"
                        android:visibility="gone"
                        tools:text="Library checked Oct 22, 2026, 10:42 AM"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/library_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/outside_inventory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:id="@+id/storage_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/downloads_audio_title"
                        android:textAppearance="?textAppearanceTitleLarge" />

                    <TextView
                        android:id="@+id/audio_usage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/downloads_checking_storage"
                        android:textAppearance="?textAppearanceHeadlineSmall"
                        tools:text="6.1 GB on this device" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/downloads_audio_scope"
                        android:textAppearance="?textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/storage_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/downloads_storage_unavailable"
                        android:textAppearance="?textAppearanceBodyMedium"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
