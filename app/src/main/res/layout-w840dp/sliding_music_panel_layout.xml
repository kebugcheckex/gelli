<?xml version="1.0" encoding="utf-8"?>
<!--
expanded width: the collapsed panel is a full-width player bar instead of the mini player,
and the queue can open as a side sheet beside the content. expanding the bar opens the full-window player.
-->
<com.sothree.slidinguppanel.SlidingUpPanelLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom"
    app:umanoOverlay="false"
    app:umanoPanelHeight="0dp"
    app:umanoShadowHeight="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/content_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/queue_sheet"
            android:layout_width="@dimen/queue_sheet_width"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="?attr/dividerColor" />

            <FrameLayout
                android:id="@+id/queue_sheet_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/sliding_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:colorBackground">

        <FrameLayout
            android:id="@+id/player_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/mini_player_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mini_player_height"
            android:background="?attr/colorSurfaceContainer"
            android:clickable="true" />

    </FrameLayout>

</com.sothree.slidinguppanel.SlidingUpPanelLayout>
