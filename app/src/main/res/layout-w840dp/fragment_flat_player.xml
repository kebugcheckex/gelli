<?xml version="1.0" encoding="utf-8"?>
<!--
the now playing pane at w840dp is a plain stack on the surface: cover, title, controls and a queue that fills the rest.
the palette colour only shows as a soft wash behind the top of the pane.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface">

    <View
        android:id="@+id/player_wash"
        android:layout_width="match_parent"
        android:layout_height="420dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.dkanada.gramophone.views.StatusBarView
            android:id="@+id/player_status_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_padding" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/player_toolbar"
            style="@style/Toolbar.Surface"
            android:background="@android:color/transparent"
            app:title="@string/now_playing"
            tools:viewBindingType="androidx.appcompat.widget.Toolbar" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="@dimen/now_playing_pane_cover_size"
            android:layout_height="@dimen/now_playing_pane_cover_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <fragment
                android:id="@+id/player_album_cover_fragment"
                class="com.dkanada.gramophone.fragments.player.PlayerAlbumCoverFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/player_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:singleLine="true"
            android:textAppearance="?textAppearanceTitleLarge"
            android:textColor="?android:textColorPrimary"
            tools:text="Song title" />

        <TextView
            android:id="@+id/player_song_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:singleLine="true"
            android:textAppearance="?textAppearanceBodyMedium"
            android:textColor="?android:textColorSecondary"
            tools:text="Artist • Album" />

        <fragment
            android:id="@+id/playback_controls_fragment"
            class="com.dkanada.gramophone.fragments.player.flat.FlatPlayerPlaybackControlsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/player_queue_sub_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="@string/up_next"
            android:textAppearance="?textAppearanceTitleSmall"
            android:textColor="?android:textColorSecondary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/player_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:requiresFadingEdge="vertical" />

    </LinearLayout>

</FrameLayout>
