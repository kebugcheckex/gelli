<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.dkanada.gramophone.views.settings.JellyPreferenceCategory android:title="@string/pref_header_local_library">

        <Preference
            app:iconSpaceReserved="false"
            android:key="downloads_storage"
            android:title="@string/downloads_storage_title"
            android:summary="@string/downloads_storage_summary" />

        <ListPreference
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="15"
            android:entries="@array/pref_original_cap_titles"
            android:entryValues="@array/pref_original_cap_values"
            android:key="library_original_cap_mb"
            android:negativeButtonText="@null"
            android:positiveButtonText="@null"
            android:title="@string/pref_title_original_cap" />

        <ListPreference
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="DELAY"
            android:entries="@array/pref_save_trigger_titles"
            android:entryValues="@array/pref_save_trigger_values"
            android:key="library_save_trigger"
            android:negativeButtonText="@null"
            android:positiveButtonText="@null"
            android:title="@string/pref_title_save_trigger" />

        <ListPreference
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="30"
            android:entries="@array/pref_save_trigger_seconds_titles"
            android:entryValues="@array/pref_save_trigger_seconds_values"
            android:key="library_save_trigger_seconds"
            android:negativeButtonText="@null"
            android:positiveButtonText="@null"
            android:title="@string/pref_title_save_trigger_seconds" />

    </com.dkanada.gramophone.views.settings.JellyPreferenceCategory>

</androidx.preference.PreferenceScreen>
